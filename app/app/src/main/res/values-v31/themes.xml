<resources>
    <style name="Theme.Tally" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#040A1E</item>
        <item name="android:windowBackground">#040A1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Keep the Android 12 system splash crisp: a dedicated vector mark, not the detailed
             mascot launcher artwork, which becomes muddy at the system icon's display size. -->
        <item name="android:windowSplashScreenBackground">#071329</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1365FE</item>
    </style>
</resources>
